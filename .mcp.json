{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    },
    "browserbase": {
      "type": "http",
      "url": "https://mcp.browserbase.com/mcp",
      "headers": {
        "Authorization": "Bearer ${BROWSERBASE_API_KEY:-}"
      }
    }
  }
}
