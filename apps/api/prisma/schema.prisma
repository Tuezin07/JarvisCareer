// JARVIS Career — modelo de dados (Fases 1 a 3).
// Tabelas das fases seguintes (vagas, candidaturas, automação) entram com suas migrações,
// quando o código que as usa existir. Visão completa em docs/01-arquitetura.md.
//
// Regra de isolamento: toda tabela com dados do candidato tem userId e é sempre
// consultada filtrando pelo userId do token de acesso.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  ADMIN
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         UserRole  @default(CANDIDATE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  profile       CandidateProfile?
  preferences   CandidatePreferences?
  experiences   Experience[]
  education     Education[]
  skills        CandidateSkill[]
  resumes       Resume[]
  refreshTokens RefreshToken[]
  consents      Consent[]
  events        AgentEvent[]
  tasks         AgentTask[]
  conversations Conversation[]
  memories      AgentMemory[]
  actions       ActionExecution[]
  usage         UsageRecord[]
  analyses      ResumeAnalysis[]
  jobSources    UserJobSource[]
  jobMatches    JobMatch[]
}

/// Refresh token opaco. Guardamos só o hash; a família permite revogar tudo em caso de reuso.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model CandidateProfile {
  userId            String   @id @db.Uuid
  fullName          String
  phone             String?
  city              String?
  state             String?  @db.VarChar(2)
  headline          String?
  summary           String?
  targetRoles       String[]
  regionsOfInterest String[]
  availability      String?
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
}

enum ContractType {
  CLT
  PJ
  INTERNSHIP
  APPRENTICE
  FREELANCE
  TEMPORARY
}

enum WorkSchedule {
  FULL_TIME
  PART_TIME
}

model CandidatePreferences {
  userId              String         @id @db.Uuid
  workModes           WorkMode[]
  contractTypes       ContractType[]
  schedules           WorkSchedule[]
  salaryExpectation   Int?
  firstJob            Boolean        @default(false)
  acceptsNoExperience Boolean        @default(true)
  /// Lista validada por constraintSchema (@jarvis/shared): kind + strength + valor.
  constraints         Json           @default("[]")
  /// Pausa global de buscas e envios automáticos deste candidato.
  searchPaused        Boolean        @default(false)
  /// Pesos do motor de compatibilidade (null = padrão público em @jarvis/shared).
  matchWeights        Json?
  updatedAt           DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ExperienceKind {
  JOB
  INTERNSHIP
  VOLUNTEER
  PROJECT
}

model Experience {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  company     String
  title       String
  kind        ExperienceKind @default(JOB)
  location    String?
  /// AAAA-MM
  startMonth  String         @db.VarChar(7)
  endMonth    String?        @db.VarChar(7)
  description String?
  position    Int            @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EducationStatus {
  COMPLETED
  IN_PROGRESS
  INCOMPLETE
}

model Education {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @db.Uuid
  institution String
  degree      String
  field       String?
  status      EducationStatus @default(COMPLETED)
  startMonth  String?         @db.VarChar(7)
  endMonth    String?         @db.VarChar(7)
  position    Int             @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum SkillKind {
  TECHNICAL
  BEHAVIORAL
  TOOL
}

enum SkillLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
}

/// Catálogo normalizado (nome em minúsculas) para estatísticas e compatibilidade.
model Skill {
  id         String    @id @default(uuid()) @db.Uuid
  normalized String    @unique
  label      String
  kind       SkillKind @default(TECHNICAL)

  candidates CandidateSkill[]
}

model CandidateSkill {
  userId  String      @db.Uuid
  skillId String      @db.Uuid
  level   SkillLevel?
  /// De onde veio: MANUAL (candidato) ou RESUME (extraída do currículo, Fase 2).
  source  String      @default("MANUAL")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
}

enum ResumeStatus {
  UPLOADED
  PROCESSING
  EXTRACTED
  FAILED
}

model Resume {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @db.Uuid
  originalName  String
  kind          String       @db.VarChar(8)
  mimeType      String
  sizeBytes     Int
  sha256        String       @db.Char(64)
  storageKey    String       @unique
  status        ResumeStatus @default(UPLOADED)
  isPrimary     Boolean      @default(false)
  extractedText String?
  pageCount     Int?
  charCount     Int?
  errorMessage  String?
  attempts      Int          @default(0)
  createdAt     DateTime     @default(now())
  extractedAt   DateTime?

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses ResumeAnalysis[]

  @@unique([userId, sha256])
  @@index([userId, createdAt])
}

enum ConsentType {
  TERMS
  PRIVACY
  AUTOMATED_APPLICATIONS
  EVIDENCE_SCREENSHOTS
}

/// Histórico imutável: cada mudança de consentimento é uma nova linha.
model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  type      ConsentType
  granted   Boolean
  version   String
  createdAt DateTime    @default(now())
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
}

enum EventLevel {
  info
  success
  warning
  error
}

/// Linha do tempo do que o JARVIS fez — base de "o que você fez nas últimas 24 horas".
model AgentEvent {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  type      String
  level     EventLevel @default(info)
  title     String
  detail    String?
  /// Referência opcional ao objeto afetado (ex.: resume:<id>).
  subject   String?
  taskId    String?    @db.Uuid
  createdAt DateTime   @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  task AgentTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum TaskStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Cada job de fundo relevante para o candidato, com limites e resultado.
model AgentTask {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  kind       String
  status     TaskStatus @default(QUEUED)
  /// Job do BullMQ (idempotência: mesmo jobId não é enfileirado duas vezes).
  queueJobId String     @unique
  attempts   Int        @default(0)
  error      String?
  createdAt  DateTime   @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events AgentEvent[]

  @@index([userId, createdAt])
}

/// Trilha de auditoria. Sem FK para User: precisa sobreviver à exclusão da conta.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  /// Pode ser null (ex.: falha de login com e-mail inexistente).
  userId    String?  @db.Uuid
  action    String
  /// Dados já redigidos — nunca senha, token ou conteúdo de currículo.
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ───────────────────────────── Fase 2 — Inteligência ─────────────────────────────

model Conversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
  actions  ActionExecution[]

  @@index([userId, updatedAt])
}

enum MessageRole {
  user
  assistant
}

enum MessageKind {
  /// Texto digitado pelo candidato.
  USER_TEXT
  /// Resposta do modelo (pode conter texto, thinking e tool_use).
  ASSISTANT
  /// Resultados das ferramentas executadas pelo backend.
  TOOL_RESULTS
}

/// Histórico append-only. `content` guarda os blocos exatamente como trocados com a API:
/// blocos de thinking precisam voltar intactos nas chamadas seguintes.
model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @db.Uuid
  userId         String      @db.Uuid
  seq            Int
  role           MessageRole
  kind           MessageKind
  content        Json
  /// Texto exibível na interface (null quando a mensagem só tem tool_result).
  displayText    String?
  model          String?
  stopReason     String?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@index([userId, createdAt])
}

enum ActionRisk {
  READ_ONLY
  REVERSIBLE
  EXTERNAL_STATE
  IRREVERSIBLE
}

enum ActionStatus {
  SUCCEEDED
  FAILED
  DENIED
}

/// Cada ferramenta que o agente pediu para executar, com a decisão do Action Router.
model ActionExecution {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  conversationId String?      @db.Uuid
  toolUseId      String?
  toolName       String
  risk           ActionRisk
  status         ActionStatus
  /// Entrada validada (sem textos longos de documentos).
  input          Json?
  /// Resumo legível do resultado, exibido na interface.
  summary        String?
  error          String?
  durationMs     Int
  createdAt      DateTime     @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([conversationId])
}

enum MemoryKind {
  FACT
  PREFERENCE
  GOAL
  DECISION
}

/// Memória estruturada do candidato. Recuperada por tipo e recência (sem embeddings por enquanto).
model AgentMemory {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  kind       MemoryKind
  content    String
  /// Origem: CONVERSATION, RESUME, PROFILE.
  source     String
  sourceRef  String?
  createdAt  DateTime   @default(now())
  archivedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, archivedAt, createdAt])
}

/// Consumo de LLM por chamada. Custo em micro-dólares (1 USD = 1_000_000).
model UsageRecord {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  route            String
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMicroUsd     Int
  conversationId   String?  @db.Uuid
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model ResumeAnalysis {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  resumeId    String         @db.Uuid
  status      AnalysisStatus @default(QUEUED)
  model       String?
  /// Nota de qualidade documental 0–100, calculada no backend a partir dos critérios.
  score       Int?
  result      Json?
  error       String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([resumeId, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────────── Fase 3 — Pesquisa de vagas ─────────────────────────────

enum JobProvider {
  GREENHOUSE
  LEVER
  ASHBY
}

enum JobSourceStatus {
  ACTIVE
  /// Falhas consecutivas; volta a ACTIVE no próximo sucesso.
  FAILING
  /// Desligada após falhas demais (circuit breaker) ou por não ter seguidores.
  DISABLED
}

/// Página pública de vagas de uma empresa num ATS. Dado público, compartilhado entre candidatos.
model JobSource {
  id                  String          @id @default(uuid()) @db.Uuid
  provider            JobProvider
  boardToken          String
  /// "eu" para o Lever europeu; null no padrão.
  region              String?
  companyName         String
  careersUrl          String
  status              JobSourceStatus @default(ACTIVE)
  consecutiveFailures Int             @default(0)
  lastSyncedAt        DateTime?
  lastError           String?
  openJobCount        Int?
  createdAt           DateTime        @default(now())

  followers UserJobSource[]
  listings  JobListing[]

  @@unique([provider, boardToken])
}

model UserJobSource {
  userId    String   @db.Uuid
  sourceId  String   @db.Uuid
  createdAt DateTime @default(now())

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  source JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@index([sourceId])
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum FraudRisk {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

/// Vaga normalizada. Vagas que somem da página de origem ganham closedAt (não são apagadas).
model JobListing {
  id             String        @id @default(uuid()) @db.Uuid
  sourceId       String        @db.Uuid
  externalId     String
  title          String
  companyName    String
  department     String?
  locations      String[]
  workplaceType  WorkplaceType @default(UNKNOWN)
  employmentType String?
  description    String
  url            String
  applyUrl       String?
  language       String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?
  /// YEAR, MONTH ou HOUR, como publicado.
  salaryPeriod   String?
  publishedAt    DateTime?
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  closedAt       DateTime?
  /// Hash do conteúdo normalizado: mudou, recalcula compatibilidade.
  contentHash    String        @db.Char(64)
  /// Empresa+cargo+local normalizados, para agrupar a mesma vaga publicada em lugares diferentes.
  dedupKey       String
  fraudRisk      FraudRisk     @default(LOW)
  fraudSignals   Json          @default("[]")

  source  JobSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  matches JobMatch[]

  @@unique([sourceId, externalId])
  @@index([dedupKey])
  @@index([sourceId, closedAt])
}

enum JobMatchStatus {
  NEW
  SAVED
  DISMISSED
}

/// Compatibilidade de uma vaga com um candidato (motor determinístico, pesos públicos).
model JobMatch {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  listingId   String         @db.Uuid
  score       Int
  eliminated  Boolean        @default(false)
  breakdown   Json
  status      JobMatchStatus @default(NEW)
  /// contentHash da vaga usado no cálculo.
  listingHash String         @db.Char(64)
  computedAt  DateTime       @default(now())

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing JobListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, eliminated, score])
}
