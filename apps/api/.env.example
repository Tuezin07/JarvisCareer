# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
PORT=4000
# Origem do frontend (CORS com credenciais)
WEB_ORIGIN=http://localhost:3000

# Infra local (infra/docker-compose.yml)
DATABASE_URL=postgresql://jarvis:jarvis_dev@127.0.0.1:5433/jarvis
REDIS_URL=redis://127.0.0.1:6380

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Armazenamento de arquivos (ADR-0005)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Fase 2 — deixe vazio até ter a chave
ANTHROPIC_API_KEY=
LLM_MODEL_PRIMARY=claude-opus-5-5
LLM_MODEL_BULK=claude-opus-5-5
# Teto de gasto com IA por candidato nas últimas 24 h (US$)
LLM_DAILY_BUDGET_USD=2
