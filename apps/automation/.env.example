# Executor de navegador (apps/automation)
REDIS_URL=redis://127.0.0.1:6380
# local (Chromium do Playwright) ou browserbase (sessões remotas; exige BROWSERBASE_API_KEY no ambiente)
BROWSER_PROVIDER=local
AUTOMATION_HEADLESS=true
AUTOMATION_CONCURRENCY=1
# host:porta liberados mesmo sendo loopback — SÓ o site de testes controlado (npm run test-site)
AUTOMATION_ALLOW_LOOPBACK=127.0.0.1:4100
