{
  "name": "@jarvis/automation",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS WEB — executor isolado de navegador (Playwright). Sem acesso ao banco: recebe tarefas pela fila e devolve resultado e evidências.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "test-site": "node --experimental-strip-types test-site/server.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@browserbasehq/sdk": "^2.27.0",
    "@jarvis/shared": "^0.1.0",
    "bullmq": "^6.7.6",
    "ioredis": "^6.0.0",
    "playwright": "^1.65.1",
    "zod": "^4.6.7"
  }
}
